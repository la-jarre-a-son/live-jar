{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
        "appState": {
            "properties": {
                "changelogDismissed": {
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "updateDismissed": {
                    "type": [
                        "null",
                        "string"
                    ]
                }
            },
            "type": "object"
        },
        "auth": {
            "properties": {
                "twitch": {
                    "anyOf": [
                        {
                            "properties": {
                                "accessToken": {
                                    "type": "string"
                                },
                                "scopes": {
                                    "items": {
                                        "type": "string"
                                    },
                                    "type": "array"
                                },
                                "type": {
                                    "const": "bearer",
                                    "type": "string"
                                }
                            },
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "type": "object"
        },
        "general": {
            "properties": {
                "autoRefreshHighLatency": {
                    "type": "boolean"
                },
                "doubleClickAction": {
                    "enum": [
                        "maximize",
                        "mute",
                        "none",
                        "solo"
                    ],
                    "type": "string"
                },
                "latencyHighThreshold": {
                    "type": "number"
                },
                "mutePrerollTimeout": {
                    "type": "number"
                },
                "reopenWindows": {
                    "type": "boolean"
                },
                "topbarStyle": {
                    "enum": [
                        "hidden",
                        "solid",
                        "transparent"
                    ],
                    "type": "string"
                },
                "volumeScrollSpeed": {
                    "type": "number"
                }
            },
            "type": "object"
        },
        "playlists": {
            "items": {
                "properties": {
                    "entries": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "label": {
                        "type": "string"
                    },
                    "type": {
                        "enum": [
                            "iframe",
                            "twitch"
                        ],
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "type": "array"
        },
        "windowState": {
            "properties": {
                "alwaysOnTop": {
                    "type": "boolean"
                },
                "height": {
                    "type": "number"
                },
                "maximized": {
                    "type": "boolean"
                },
                "width": {
                    "type": "number"
                },
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                }
            },
            "type": "object"
        },
        "windows": {
            "items": {
                "anyOf": [
                    {
                        "properties": {
                            "channel": {
                                "type": "string"
                            },
                            "id": {
                                "type": "number"
                            },
                            "label": {
                                "type": "string"
                            },
                            "quality": {
                                "type": "string"
                            },
                            "state": {
                                "anyOf": [
                                    {
                                        "allOf": [
                                            {
                                                "properties": {
                                                    "alwaysOnTop": {
                                                        "type": "boolean"
                                                    },
                                                    "height": {
                                                        "type": "number"
                                                    },
                                                    "maximized": {
                                                        "type": "boolean"
                                                    },
                                                    "width": {
                                                        "type": "number"
                                                    },
                                                    "x": {
                                                        "type": "number"
                                                    },
                                                    "y": {
                                                        "type": "number"
                                                    }
                                                },
                                                "type": "object"
                                            },
                                            {
                                                "properties": {
                                                    "enabled": {
                                                        "type": "boolean"
                                                    },
                                                    "ignoreSolo": {
                                                        "type": "boolean"
                                                    },
                                                    "locked": {
                                                        "type": "boolean"
                                                    },
                                                    "muted": {
                                                        "type": "boolean"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "type": {
                                "const": "twitch",
                                "type": "string"
                            },
                            "url": {
                                "type": "string"
                            },
                            "volume": {
                                "type": "number"
                            }
                        },
                        "type": "object"
                    },
                    {
                        "properties": {
                            "id": {
                                "type": "number"
                            },
                            "label": {
                                "type": "string"
                            },
                            "quality": {
                                "type": "string"
                            },
                            "state": {
                                "anyOf": [
                                    {
                                        "allOf": [
                                            {
                                                "properties": {
                                                    "alwaysOnTop": {
                                                        "type": "boolean"
                                                    },
                                                    "height": {
                                                        "type": "number"
                                                    },
                                                    "maximized": {
                                                        "type": "boolean"
                                                    },
                                                    "width": {
                                                        "type": "number"
                                                    },
                                                    "x": {
                                                        "type": "number"
                                                    },
                                                    "y": {
                                                        "type": "number"
                                                    }
                                                },
                                                "type": "object"
                                            },
                                            {
                                                "properties": {
                                                    "enabled": {
                                                        "type": "boolean"
                                                    },
                                                    "ignoreSolo": {
                                                        "type": "boolean"
                                                    },
                                                    "locked": {
                                                        "type": "boolean"
                                                    },
                                                    "muted": {
                                                        "type": "boolean"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "type": {
                                "const": "iframe",
                                "type": "string"
                            },
                            "url": {
                                "type": "string"
                            },
                            "volume": {
                                "type": "number"
                            }
                        },
                        "type": "object"
                    }
                ]
            },
            "type": "array"
        }
    },
    "type": "object"
}

